{
  "opencollection": "1.0.0",
  "info": {
    "name": "Dsco Platform Authentication Catalog API",
    "version": "v3"
  },
  "items": [
    {
      "info": {
        "name": "Catalog",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Update Supplier Catalog",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.dsco.io/api/v3/supplier/catalog-in",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Supplier operation to create or update product catalog items. Supports small batch (synchronous) and large batch (asynchronous) modes."
        },
        {
          "info": {
            "name": "Update Catalog Attribution",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.dsco.io/api/v3/retailer/catalog-in",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retailer operation to update catalog attribution data. Large batch only."
        }
      ]
    }
  ],
  "bundled": true
}